set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
if(NOT DEFINED ENV{WIN_LLVM_ROOT} OR NOT DEFINED ENV{WIN_SDK})
  message(FATAL_ERROR "Set WIN_LLVM_ROOT (LLVM bin parent) and WIN_SDK (xwin splat root)")
endif()
file(TO_CMAKE_PATH "$ENV{WIN_LLVM_ROOT}" WINX_LLVM)
file(TO_CMAKE_PATH "$ENV{WIN_SDK}" WINX_SDK)
set(CMAKE_C_COMPILER "${WINX_LLVM}/bin/clang-cl")
set(CMAKE_CXX_COMPILER "${WINX_LLVM}/bin/clang-cl")
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_RC_COMPILER "${WINX_LLVM}/bin/llvm-rc")
set(CMAKE_LINKER "${WINX_LLVM}/bin/lld-link")
set(CMAKE_AR "${WINX_LLVM}/bin/llvm-lib")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
set(WINX_INCLUDES "/imsvc${WINX_SDK}/crt/include /imsvc${WINX_SDK}/sdk/include/ucrt /imsvc${WINX_SDK}/sdk/include/shared /imsvc${WINX_SDK}/sdk/include/um /imsvc${WINX_SDK}/sdk/include/winrt")
set(CMAKE_C_FLAGS_INIT "${WINX_INCLUDES}")
set(CMAKE_CXX_FLAGS_INIT "${WINX_INCLUDES} /EHsc")
set(CMAKE_RC_FLAGS_INIT "/I${WINX_SDK}/crt/include /I${WINX_SDK}/sdk/include/ucrt /I${WINX_SDK}/sdk/include/shared /I${WINX_SDK}/sdk/include/um")
set(WINX_LIBPATHS "/libpath:${WINX_SDK}/crt/lib/x86_64 /libpath:${WINX_SDK}/sdk/lib/ucrt/x86_64 /libpath:${WINX_SDK}/sdk/lib/um/x86_64")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${WINX_LIBPATHS} /manifest:embed")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${WINX_LIBPATHS}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${WINX_LIBPATHS}")
# LLD embeds manifests itself. Avoid CMake's Windows-only external mt.exe step.
set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/windows-lld-rules.cmake")
set(CMAKE_FIND_ROOT_PATH "${WINX_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Optional: run Windows build tools (the VST3 manifest helper) under Wine.
if(DEFINED ENV{WIN_WINE})
  set(CMAKE_CROSSCOMPILING_EMULATOR "$ENV{WIN_WINE}")
endif()
